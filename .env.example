# Copier en .env et remplir. Ne jamais committer .env (déjà dans .gitignore).

# Clé API Anthropic (optionnel — uniquement pour l'agent LangGraph)
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Transport MCP : stdio (Claude Desktop) | streamable-http | sse
MCP_TRANSPORT=stdio

# Adresse et port en mode HTTP (ignoré si MCP_TRANSPORT=stdio)
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Chemin de la base SQLite (optionnel — défaut : brvm_history.db à la racine)
# BRVM_DB=/data/brvm_history.db

# ── Clés API payantes (rate limit bypass) ──────────────────────────────────
# Dictionnaire JSON : {"uuid": {"tier": "pro|business", "email": "...", "name": "...", "created": "YYYY-MM-DD"}}
# Générer via : python admin_add_key.py add --email X --tier pro
# Copier la valeur affichée dans Railway → Variables → BRVM_API_KEYS
BRVM_API_KEYS={}

# URL publique du service Railway (utilisée par admin_add_key.py dans les templates email)
# Ex : https://brvm-mcp-production.up.railway.app
RAILWAY_SERVICE_URL=https://votre-app.up.railway.app
